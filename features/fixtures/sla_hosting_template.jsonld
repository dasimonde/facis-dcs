      }
    },
    {
      "@id": "did:web:example:template:sla-hosting#field-currency",
      "@type": "dcs:ContractField",
      "dcs:datatype": "xsd:string",
      "dcs:label": "Payment Currency",
      "dcs:required": true,
      "dcs:shape": {
        "@id": "https://w3id.org/facis/dcs/taxonomy/v1#field-contract-payment-currency"
      },
      "dcs:valueConstraint": {
        "allowedValues": [
          "EUR",
          "USD"
        ],
        "allowedValuesRef": "ISO 4217",
        "description": "ISO 4217 Currency Constraint",
        "format": "iso-4217",
        "iri": "https://w3id.org/facis/dcs/taxonomy/v1#constraint-iso4217-currency",
        "odrlLeftOperands": [],
        "pattern": "^[A-Z]{3}$",
        "valueCatalog": {
          "iri": "https://w3id.org/facis/dcs/taxonomy/v1#catalog-iso4217-currency",
          "label": "ISO 4217 Currencies"
        },
        "valueOptions": [
          {
            "catalog": {
              "iri": "https://w3id.org/facis/dcs/taxonomy/v1#catalog-iso4217-currency",
              "label": "ISO 4217 Currencies"
            },
            "iri": "https://w3id.org/facis/dcs/taxonomy/v1#currency-EUR",
            "label": "Euro",
            "symbol": "€",
            "value": "EUR"
          },
          {
            "catalog": {
              "iri": "https://w3id.org/facis/dcs/taxonomy/v1#catalog-iso4217-currency",
              "label": "ISO 4217 Currencies"
            },
            "iri": "https://w3id.org/facis/dcs/taxonomy/v1#currency-USD",
            "label": "US Dollar",
            "symbol": "$",
            "value": "USD"
          }
        ]
      }
    },
    {
