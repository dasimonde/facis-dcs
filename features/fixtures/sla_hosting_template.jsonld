  "dcs:documentStructure": {
    "@id": "did:web:example:template:sla-hosting#document-structure",
    "@type": "dcs:DocumentStructure",
    "dcs:blocks": {
      "@list": [
        {
          "@id": "did:web:example:template:sla-hosting#block-section-parties",
          "@type": "dcs:Section",
          "dcs:title": "1. Parties and Term"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-environment",
          "@type": "dcs:Section",
          "dcs:title": "2. Provisioned Environment"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-service-levels",
          "@type": "dcs:Section",
          "dcs:title": "3. Service Levels"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-charges",
          "@type": "dcs:Section",
          "dcs:title": "4. Charges and Payment"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-service-credits",
          "@type": "dcs:Section",
          "dcs:title": "5. Service Credits"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-use-restrictions",
          "@type": "dcs:Section",
          "dcs:title": "6. Use Restrictions"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-section-signatures",
          "@type": "dcs:Section",
          "dcs:title": "7. Signatures"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-parties",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "This Managed Kubernetes Hosting Agreement is entered into between Nordwind Cloud Services GmbH (the Provider) and Hansa Logistics AG (the Customer)."
            ]
          },
          "dcs:title": "Parties"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-governing-law",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "This agreement is governed by the law of ",
              {
                "@id": "did:web:example:template:sla-hosting#field-governing-law"
              },
              "."
            ]
          },
          "dcs:title": "Governing law"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-environment",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Provider provisions ",
              {
                "@id": "did:web:example:template:sla-hosting#field-provisioned-nodes"
              },
              " worker nodes of class ",
              {
                "@id": "did:web:example:template:sla-hosting#field-node-class"
              },
              " in service region ",
              {
                "@id": "did:web:example:template:sla-hosting#field-service-region"
              },
              ". The Customer may execute production workloads on that environment until ",
              {
                "@id": "did:web:example:template:sla-hosting#field-contract-end-date"
              },
              ". Where availability falls short, the Provider owes a service credit of ",
              {
                "@id": "did:web:example:template:sla-hosting#field-service-credit-rate"
              },
              " percent."
            ]
          },
          "dcs:title": "Provisioned environment and workload execution"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-maintenance",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Provider may modify the provisioned environment to carry out planned maintenance, and informs the Customer at least five days beforehand."
            ]
          },
          "dcs:title": "Planned maintenance"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-availability",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Provider maintains an availability of at least ",
              {
                "@id": "did:web:example:template:sla-hosting#field-committed-availability"
              },
              " percent, measured over each ",
              {
                "@id": "did:web:example:template:sla-hosting#field-measurement-window"
              },
              "."
            ]
          },
          "dcs:title": "Availability"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-incident-response",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Provider informs the Customer of a priority-1 incident within ",
              {
                "@id": "did:web:example:template:sla-hosting#field-incident-response-minutes"
              },
              " minutes of detecting it."
            ]
          },
          "dcs:title": "Incident response"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-data-residency",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Provider processes and stores all Customer data inside the agreed service region."
            ]
          },
          "dcs:title": "Data residency"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-charges",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Customer pays ",
              {
                "@id": "did:web:example:template:sla-hosting#field-monthly-fee"
              },
              " ",
              {
                "@id": "did:web:example:template:sla-hosting#field-currency"
              },
              " per ",
              {
                "@id": "did:web:example:template:sla-hosting#field-billing-period"
              },
              ", due within fourteen days of the invoice date."
            ]
          },
          "dcs:title": "Charges and payment"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-service-credits",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "A service credit is settled against the next invoice for the affected billing period."
            ]
          },
          "dcs:title": "Service credits"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-no-resale",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Customer must not sell the provisioned environment, or any part of it, to a third party or to the public."
            ]
          },
          "dcs:title": "No resale"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-no-grant-use",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Customer must not grant use of the support service to a third party or to an affiliate."
            ]
          },
          "dcs:title": "No onward grant of use"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-no-capacity-excess",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "The Customer must not run more worker nodes than the provisioned capacity."
            ]
          },
          "dcs:title": "No capacity excess"
        },
        {
          "@id": "did:web:example:template:sla-hosting#block-clause-signature-level",
          "@type": "dcs:Clause",
          "dcs:content": {
            "@list": [
              "Both parties sign this agreement at signature level ",
              {
                "@id": "did:web:example:template:sla-hosting#field-required-signature-level"
              },
              "."
            ]
          },
          "dcs:title": "Signature level"
        }
      ]
    },
