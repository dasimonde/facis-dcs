          "CH",
          "EU"
        ],
        "description": "Governing Law Vocabulary Constraint",
        "format": "controlled-vocabulary",
        "iri": "https://w3id.org/facis/dcs/taxonomy/v1#constraint-governing-law",
        "odrlLeftOperands": [],
        "valueOptions": []
      }
    },
    {
      "@id": "did:web:example:template:sla-hosting#field-provisioned-nodes",
      "@type": "dcs:ContractField",
      "dcs:datatype": "xsd:integer",
      "dcs:label": "Managed Kubernetes Environment · Provisioned nodes",
      "dcs:required": true,
      "dcs:shape": {
        "@id": "https://w3id.org/facis/sla/hosting/v1#provisionedNodes"
      },
      "dcs:valueConstraint": {
        "max": 500,
