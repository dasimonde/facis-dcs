#-- Frontend Build Stage --
FROM node:22-alpine AS frontend-builder

WORKDIR /frontend

# Copy frontend package files
COPY frontend/ClientApp/package*.json ./
COPY frontend/ClientApp/package-lock.json ./

# Install frontend dependencies
RUN npm ci

# Copy frontend source
COPY frontend/ClientApp/ ./

# Build frontend (type-checking skipped — use build:docker to avoid blocking on TS errors)
RUN npm run build:docker


#-- Go Build Stage --
# glibc (Debian) toolchain with cgo: the PKCS#11 layer (ThalesGroup/crypto11 →
# miekg/pkcs11) is cgo-only, so a static CGO_ENABLED=0 build cannot link it.
FROM golang:1.25 AS go-builder

WORKDIR /build

# Copy go mod files
COPY backend/go.mod backend/go.sum ./

# Download dependencies ("all" also covers cmd/goa's tool-only deps so the
# gen step below runs entirely from the module cache).
RUN go mod download all

# Copy source code
COPY backend/ ./

# Generate Goa transport/types from the design package, at the goa version
# pinned in go.mod. GOPROXY=off keeps the step hermetic.
RUN GOPROXY=off go run goa.design/goa/v3/cmd/goa gen digital-contracting-service/design

# Build binary (cgo enabled so the PKCS#11 signing path links).
RUN CGO_ENABLED=1 GOOS=linux go build -o dcs ./cmd/dcs
# BDD/CI helpers: gendid regenerates did.json from the token key inside the
# hsm-provision hook job; hsmsign lets the BDD harness sign did:web challenges
# with the in-cluster token via kubectl exec (no extractable private keys).
RUN CGO_ENABLED=1 GOOS=linux go build -o gendid ./cmd/gendid && \
    CGO_ENABLED=1 GOOS=linux go build -o hsmsign ./cmd/hsmsign
# pacmonitor runs one continuous-compliance sweep and exits; the CronJob in the
# chart runs it on a schedule (DCS-FR-PACM-02). Same image as the server so the
# sweep and the code it audits can never drift apart in a deployment.
RUN CGO_ENABLED=1 GOOS=linux go build -o pacmonitor ./cmd/pacmonitor

# gendid regenerates did.json from the HSM dcs-did token key (see dev-stack.sh);
# the hsm-provision Job reuses the same binary so CI derives did.json from the
# freshly-provisioned token key exactly like native dev-stack does, rather
# than duplicating that logic in shell.
RUN CGO_ENABLED=1 GOOS=linux go build -o gendid ./cmd/gendid


#-- Runtime Stage --
FROM debian:stable-slim

ARG DOCKER_USER=default_user

ENV DEBIAN_FRONTEND=noninteractive

# softhsm2 provides libsofthsm2.so (the PKCS#11 module the backend dlopens) and
# softhsm2-util. opensc provides pkcs11-tool, openssl issues the dev x5chain,
# curl+jq let the provisioning job write did.json into a Kubernetes Secret.
# SoftHSM2 is a software token for dev/staging/CI only, never a production HSM.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    gnupg \
    softhsm2 \
    opensc \
    openssl \
    curl \
    jq && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r "${DOCKER_USER}" && useradd -r -g "${DOCKER_USER}" "${DOCKER_USER}"

RUN mkdir -p /home/${DOCKER_USER}
RUN chmod 0777 /home/${DOCKER_USER}

RUN mkdir -p /app
RUN chown $DOCKER_USER:$DOCKER_USER /app

# Create directory for custom CA certificates
RUN mkdir -p /usr/local/share/ca-certificates/custom
RUN chmod 755 /usr/local/share/ca-certificates/custom

WORKDIR /app

USER $DOCKER_USER

# Copy compiled binaries from go-builder stage
COPY --from=go-builder /build/dcs /app/dcs
COPY --from=go-builder /build/gendid /app/gendid

# Copy BDD/CI helper binaries (gendid, hsmsign) — see go-builder stage above.
COPY --from=go-builder /build/gendid /build/hsmsign /app/

# Scheduled continuous-compliance sweep (DCS-FR-PACM-02).
COPY --from=go-builder /build/pacmonitor /app/pacmonitor

# Copy OID4VP issuer trust for DCS.
COPY --from=go-builder --chown=$DOCKER_USER:$DOCKER_USER \
  /build/config/oid4vp/trust.dev.json /app/config/oid4vp/trust.dev.json

# Optional x5c chain-validation trust anchors (OID4VP_X5C_TRUST_ANCHORS_PATH,
# unset/gated off in production — dev/BDD only, see values.bdd.yml).
COPY --from=go-builder --chown=$DOCKER_USER:$DOCKER_USER \
  /build/config/oid4vp/x5c-trust-anchors.dev.pem /app/config/oid4vp/x5c-trust-anchors.dev.pem

# Copy generated OpenAPI spec from go-builder stage
COPY --from=go-builder /build/gen/http/openapi3.json /app/gen/http/openapi3.json
COPY --chown=$DOCKER_USER:$DOCKER_USER docs/policies/ /app/docs/policies/

# Copy built frontend from frontend-builder stage
COPY --from=frontend-builder --chown=$DOCKER_USER:$DOCKER_USER /frontend/dist /app/web/dist

# Copy frontend config injection script
COPY --chown=$DOCKER_USER:$DOCKER_USER frontend/ClientApp/inject-config.sh /app/web/
RUN chmod +x /app/web/inject-config.sh

# Copy SoftHSM2 token + x5chain provisioning scripts used by the Helm hook Job.
# did.json is instead generated by the /app/gendid binary above (same tool
# dev-stack.sh uses natively), not a shell reimplementation.
COPY --chown=$DOCKER_USER:$DOCKER_USER scripts/hsm-provision.sh scripts/c2pa-cert-provision.sh /app/scripts/
RUN chmod +x /app/scripts/hsm-provision.sh /app/scripts/c2pa-cert-provision.sh

# Copy entrypoint script
COPY --chown=$DOCKER_USER:$DOCKER_USER backend/docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Environment variable declarations (no defaults - must be provided at runtime)
ENV DATABASE_URL=""
ENV NATS_URL=""
ENV HYDRA_PUBLIC_ISSUER_URL=""
ENV HYDRA_INTERNAL_ISSUER_URL=""
ENV HYDRA_CLIENT_ID=""
ENV HYDRA_CLIENT_SECRET=""
ENV HYDRA_REDIRECT_URI=""
ENV HYDRA_POST_LOGOUT_REDIRECT_URI=""
ENV HYDRA_ADMIN_URL=""
ENV FC_KEYCLOAK_REALM_URL=""
ENV FEDERATED_CATALOGUE_API_URL=""
ENV FEDERATED_CATALOGUE_CLIENT_ID=""
ENV FEDERATED_CATALOGUE_CLIENT_SECRET=""

# Frontend and Backend path configuration (production defaults)
ENV DCS_UI_PATH="/ui/"
ENV DCS_API_PATH="/"

EXPOSE 8991

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/dcs"]
