# Backend dev environment – matches the NodePort services from values.dev.yml.
# Usage (from project root):
#   make dev
#
# This will setup Helm, fetch cert-chain from K8s, copy this file to .env, and run air.

DCS_DEBUG_EVENTING=false

DATABASE_URL="host=localhost port=31513 user=dcs password=dcs dbname=dcs sslmode=disable"

HYDRA_PUBLIC_ISSUER_URL=http://localhost:5174
HYDRA_INTERNAL_ISSUER_URL=http://localhost:30555
HYDRA_CLIENT_ID=dcs-client
HYDRA_CLIENT_SECRET=dcs-secret
HYDRA_REDIRECT_URI=http://localhost:5174/api/auth/callback
HYDRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/api/auth/logout-complete
HYDRA_ADMIN_URL=http://localhost:31285

NATS_URL=nats://localhost:30122

DCS_DID=./certs/dev/did-8992.json
DCS_FORCE_EIDAS_CERT=false

# PKCS#11 token (SoftHSM2 in dev) holding every private key (DCS-IR-HI-01).
# Instance B uses its own token dir; dev-stack2.sh injects the absolute
# SOFTHSM2_CONF path after provisioning the token.
PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
PKCS11_TOKEN_LABEL=dcs
PKCS11_PIN=1234
DCS_HSM_KEY_DID=dcs-did
DCS_HSM_KEY_VC=dcs-vc
DCS_HSM_KEY_JAR=dcs-oid4vp-jar
DCS_HSM_KEY_C2PA=dcs-c2pa

# Must match this instance's own DID (DCS_DID's "id") — used to derive the
# lifecycle VC's issuer/verificationMethod (see
# backend/internal/pdfgeneration/provenance/vc_signer_hsm.go).
ISSUER_DID=did:web:localhost%3A8992

DCS_BACKEND_PORT=8992

DCS_API_PATH=/api
DCS_UI_PATH=/ui/
DCS_PUBLIC_BASE_URL=http://localhost:5174/api

# The dev fixture is keyed to material committed in this repo; saying so is
# what keeps a deployment from inheriting it silently.
DCS_ALLOW_DEV_TRUST=true
OID4VP_TRUST_DATA_PATH=config/oid4vp/trust.dev.json
# Roots an x5c-bearing credential's chain must verify against: the dev PID
# issuer's self-signed anchor and the root the dev ORCE credential issuer is
# handed instead of generating one, which is what its signed status list
# chains to (scripts/orce-dev-root-ca.py).
OID4VP_X5C_TRUST_ANCHORS_PATH=config/oid4vp/x5c-trust-anchors.dev.pem
AUTH_INSECURE_COOKIES=true

# Federated Catalogue: instance A's, consumed — not a second one. dev-stack.sh
# (release "dcs") publishes fc-service on NodePort 30081 and its FC Keycloak on
# 30080; instance B's backend runs natively on the host, so it reaches both
# through those same NodePorts. Identical values to .env.dev1 on purpose.
#
# All four must be set together or the backend exits at startup
# ("incomplete Federated Catalogue configuration") — setting only some of
# them crash-loops instance B.
#
# The realm is the one the chart's fc-realm-provision job creates. It is NOT
# "gaia-x": that realm is never provisioned, so the backend retries for ten
# minutes and exits.
#
# ADR-18: this service account holds ADMIN_ALL on the shared catalogue, so
# instance B can administer instance A's entries. Acceptable for a local,
# disposable dev catalogue where both instances are ours; not tenant isolation.
FC_KEYCLOAK_REALM_URL=http://localhost:30080/auth/realms/federated-catalogue-realm
FEDERATED_CATALOGUE_API_URL=http://localhost:30081
FEDERATED_CATALOGUE_CLIENT_ID=federated-catalogue
FEDERATED_CATALOGUE_CLIENT_SECRET=**********

IPFS_TENANT_BASE_URL=http://localhost:30486/v1/tenants/tenant_space
IPFS_MFS_BASE_URL=http://localhost:31512

# The certificate chain that publishes this instance's signing key. The
# status list it serves carries it as x5c, and its own trust anchor is read
# back out of it — a deployment verifies its own list the same way it
# verifies anyone else's. Written by scripts/c2pa-cert-provision.sh.
DCS_ISSUER_X5CHAIN_PATH=../pdf-core/certs/dev/c2pa-x5chain-8992.pem

PDF_CORE_URL=http://localhost:8080

# Public base URL of this DCS instance (instance B). Used to build the C2PA
# remote-manifest URL embedded as the PDF's XMP dcterms:provenance property
# (DCS-OR-C2PA-008 AC3, ADR-4).
DCS_PUBLIC_URL=http://localhost:8992/api

# JSON-LD @context IRI for the pdf-core ontology, embedded in every contract/template envelope.
# In co-deployment, points at the pdf-core context endpoint.
# Swap to a registered w3id IRI once available.
PDF_CORE_CONTEXT_IRI=http://localhost:8080/ontology/dcs-pdf-core

# Both local backend instances use the shared RFC 3161 ORCE TSA from instance A.
# dev-stack.sh exports the matching public certificate from the release Secret.
TSA_URL=http://localhost:30180/tsa/
TSA_TRUST_CERT_FILE=certs/dev/orce-tsa-cert.pem

# Federation trust gate (ADR-19): both local backend instances share
# instance A's ORCE (see TSA_URL above), so both point their local policy
# endpoint at the same bootstrap 200-OK Node-RED flow
# (deployment/helm/charts/orce/flows/trust-pdp-flow.json).
DCS_TRUST_PDP_URL=http://localhost:30180/trust-pdp
SOFTHSM2_CONF=/home/ginoezue/.dcs/softhsm-8992/softhsm2.conf
