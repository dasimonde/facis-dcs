@prefix dcs: <https://w3id.org/facis/dcs/ontology/v1#> .
@prefix dcst: <https://w3id.org/facis/dcs/taxonomy/v1#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Default domain-field catalog for SLA contracting. Deployments can register
# additional vocabularies and shapes in the Semantic Hub.
#
# This file is parsed configuration, not axioms. What reads it: the field
# picker and the audit's known-field check index subjects typed
# dcs:DomainField, taking rdfs:label, rdfs:range (which input widget) and
# rdfs:domain (which group). dcs:ValueConstraint nodes and their SKOS
# catalogs supply the choices a form offers and the labels beside them.
#
# What does NOT read it: any gate. A dcs:pattern, dcs:minInclusive or
# dcs:allowedValue below is never compared against a submitted value on any
# server-side path — the frontend checks them before submit, and that is
# all. Value constraints that are ENFORCED are SHACL, declared as
# sh:pattern / sh:in / sh:minInclusive in facis-dcs-clause-catalog.ttl,
# which is concatenated into the shapes graph every document is validated
# against at offer, submit and sign.

<https://w3id.org/facis/sla/ontology>
  rdfs:label "FACIS SLA Domain Fields"@en ;
  rdfs:comment "Domain-field catalog for SLA contracting; register additional vocabularies in the Semantic Hub."@en .

# ---- Entity classes a field's rdfs:domain names ----

dcs:CompanyParty a rdfs:Class ;
  rdfs:label "Company Party"@en ;
  rdfs:comment "A company acting as a contract party; its dcs:role names its function in the contract."@en .

dcs:PaymentTerm a rdfs:Class ; rdfs:label "Payment Term"@en .
dcs:LegalTerms a rdfs:Class ; rdfs:label "Legal Terms"@en .
dcs:SLO a rdfs:Class ; rdfs:label "Service Level Objective"@en .
dcs:SignatureRequirement a rdfs:Class ; rdfs:label "Signature Requirement"@en .

dcs:DomainField
  rdfs:label "Domain Field"@en ;
  skos:definition "A contract field templates bind clause content and ODRL constraints to; its IRI is its identity. The marker type this file's readers index on."@en .

dcs:ContractPartyRoleCode a rdfs:Class ;
  rdfs:label "Contract Party Role Code"@en .

# ---- Document-level party + its contract role (drives entity roles) ----

dcs:party a rdf:Property ;
  rdfs:label "Company Party"@en ;
  rdfs:range dcs:CompanyParty .

dcs:role a rdf:Property ;
  rdfs:label "Role"@en ;
  rdfs:range dcs:ContractPartyRoleCode ;
  dcs:hasValueConstraint dcst:constraint-contract-party-role .

# ---- Value constraints + taxonomies ----

dcst:catalog-iso3166-alpha3-country a skos:ConceptScheme ;
  skos:prefLabel "ISO 3166-1 alpha-3 Countries"@en .

dcst:catalog-facis-service-region a skos:ConceptScheme ;
  skos:prefLabel "FACIS Service Regions"@en .

dcst:catalog-service-purpose a skos:ConceptScheme ;
  skos:prefLabel "Service Purposes"@en .

dcst:catalog-data-use-purpose a skos:ConceptScheme ;
  skos:prefLabel "Data Use Purposes"@en .

dcst:catalog-contract-party-role a skos:ConceptScheme ;
  skos:prefLabel "Contract Party Roles"@en .

dcst:catalog-iso4217-currency a skos:ConceptScheme ;
  skos:prefLabel "ISO 4217 Currencies"@en .

dcst:constraint-iso3166-alpha3-country a dcs:ValueConstraint ;
  dcs:valueType dcs:CountryReference ;
  dcs:format "iso-3166-1-alpha-3" ;
  dcs:pattern "^[A-Z]{3}$" ;
  dcs:allowedValuesRef "ISO 3166-1 alpha-3" ;
  dcs:odrlLeftOperand odrl:spatial ;
  dcs:valueCatalog dcst:catalog-iso3166-alpha3-country ;
  dcs:allowedValue "DEU", "AUT", "CHE", "FRA", "NLD", "BEL", "LUX", "POL", "CZE", "ESP", "ITA", "GBR", "USA", "DNK", "SWE", "NOR", "FIN", "IRL", "PRT", "GRC", "CAN", "JPN", "AUS" ;
  rdfs:label "ISO 3166-1 alpha-3 Country Constraint"@en .

dcst:constraint-facis-service-region a dcs:ValueConstraint ;
  dcs:format "controlled-vocabulary" ;
  dcs:odrlLeftOperand odrl:spatial ;
  dcs:valueCatalog dcst:catalog-facis-service-region ;
  dcs:allowedValue "EMEA", "AMER", "APAC" ;
  rdfs:label "FACIS Service Region Constraint"@en .

dcst:constraint-service-purpose a dcs:ValueConstraint ;
  dcs:format "controlled-vocabulary" ;
  dcs:odrlLeftOperand odrl:purpose ;
  dcs:valueCatalog dcst:catalog-service-purpose ;
  dcs:allowedValue "FULFILMENT", "OPERATIONS" ;
  rdfs:label "Service Purpose Constraint"@en .

dcst:constraint-data-use-purpose a dcs:ValueConstraint ;
  dcs:format "controlled-vocabulary" ;
  dcs:odrlLeftOperand odrl:purpose ;
  dcs:valueCatalog dcst:catalog-data-use-purpose ;
  dcs:allowedValue "OPERATIONS", "RESEARCH" ;
  rdfs:label "Data Use Purpose Constraint"@en .

dcst:constraint-iso4217-currency a dcs:ValueConstraint ;
  dcs:valueType dcs:CurrencyReference ;
  dcs:format "iso-4217" ;
  dcs:pattern "^[A-Z]{3}$" ;
  dcs:allowedValuesRef "ISO 4217" ;
  dcs:valueCatalog dcst:catalog-iso4217-currency ;
  dcs:allowedValue "EUR", "USD", "GBP", "CHF", "PLN", "CZK" ;
  rdfs:label "ISO 4217 Currency Constraint"@en .

dcst:constraint-governing-law a dcs:ValueConstraint ;
  dcs:valueCatalog dcst:catalog-governing-law ;
  dcs:format "controlled-vocabulary" ;
  dcs:allowedValue "DE", "AT", "CH", "FR", "NL", "BE", "EU" ;
  rdfs:label "Governing Law Vocabulary Constraint"@en .

dcst:constraint-eidas-signature-level a dcs:ValueConstraint ;
  dcs:valueCatalog dcst:catalog-eidas-signature-level ;
  dcs:format "eidas-signature-level" ;
  dcs:allowedValue "SES", "AES", "QES" ;
  rdfs:label "eIDAS Signature Level Constraint"@en .

dcst:constraint-sla-availability-percent a dcs:ValueConstraint ;
  dcs:minInclusive 0 ;
  dcs:maxInclusive 100 ;
  dcs:format "percentage" ;
  rdfs:label "SLA Availability Percentage Constraint"@en .

dcst:constraint-contract-party-role a dcs:ValueConstraint ;
  dcs:format "controlled-vocabulary" ;
  dcs:valueCatalog dcst:catalog-contract-party-role ;
  dcs:allowedValue dcst:role-provider, dcst:role-customer, dcst:role-supplier, dcst:role-client ;
  rdfs:label "Contract Party Role Vocabulary Constraint"@en .

dcst:role-provider a skos:Concept ;
  skos:inScheme dcst:catalog-contract-party-role ; skos:notation "provider" ; skos:prefLabel "provider"@en .
dcst:role-customer a skos:Concept ;
  skos:inScheme dcst:catalog-contract-party-role ; skos:notation "customer" ; skos:prefLabel "customer"@en .
dcst:role-supplier a skos:Concept ;
  skos:inScheme dcst:catalog-contract-party-role ; skos:notation "supplier" ; skos:prefLabel "supplier"@en .
dcst:role-client a skos:Concept ;
  skos:inScheme dcst:catalog-contract-party-role ; skos:notation "client" ; skos:prefLabel "client"@en .

